<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="center" prefHeight="439.0" prefWidth="546.0" spacing="15" style="-fx-background-color: #f4f4f4; -fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.LoginController">
   <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@logo.png" />
      </image></ImageView>
    <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Login" />

    <TextField fx:id="emailField" promptText="Email" style="-fx-pref-width: 250px;" />
    <PasswordField fx:id="passwordField" promptText="Password" style="-fx-pref-width: 250px;" />

    <Button onAction="#handleLogin" style="-fx-pref-width: 250px; -fx-background-color: #4CAF50; -fx-text-fill: white;" text="Login" />
</VBox>
