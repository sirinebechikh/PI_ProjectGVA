<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.AdminController"
      style="-fx-padding: 20; -fx-background-color: #f9f9f9;">
    <!-- Title -->
    <Label text="Admin Booking Confirmation" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" />

    <!-- Table View -->
    <TableView fx:id="bookingsTable" prefHeight="400" onMouseClicked="#handleRowClick"
               style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: white;">
        <columns>
            <TableColumn text="Booking ID" fx:id="bookingIdColumn" prefWidth="100" style="-fx-alignment: CENTER;" />
            <TableColumn text="User Name" fx:id="userNameColumn" prefWidth="200" style="-fx-alignment: CENTER;" />
        </columns>
    </TableView>

    <!-- Footer -->
    <HBox spacing="10" alignment="CENTER">
        <Label text="Click on a row to view booking details." style="-fx-font-size: 14px; -fx-text-fill: #666;" />
    </HBox>
</VBox>