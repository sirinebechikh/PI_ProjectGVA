                              <Button fx:id="uploadButton" layoutX="387.0" layoutY="197.0" mnemonicParsing="false" onAction="#uploadImage" prefHeight="44.0" prefWidth="153.0" text="upload" textFill="#57c922" />
                              <ImageView fx:id="QrCode" fitHeight="105.0" fitWidth="175.0" layoutX="21.0" layoutY="4.0" pickOnBounds="true" preserveRatio="true" />
