<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="center" prefHeight="502.0" prefWidth="475.0" spacing="15" style="-fx-background-color: #f4f4f4; -fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Controller.SignUpController">
    <Text style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Create Account" />

    <TextField fx:id="nomField" promptText="Full Name" style="-fx-pref-width: 250px;" />
    <TextField fx:id="emailField" promptText="Email" style="-fx-pref-width: 250px;" />
    <PasswordField fx:id="motDePasseField" promptText="Password" style="-fx-pref-width: 250px;" />
    <TextField fx:id="telephoneField" promptText="Phone Number" style="-fx-pref-width: 250px;" />

    <Button onAction="#handleSignUp" style="-fx-pref-width: 250px; -fx-background-color: #4CAF50; -fx-text-fill: white;" text="Sign Up" />

    <Label fx:id="loginLink" onMouseClicked="#handleLogin" style="-fx-font-size: 12px; -fx-text-fill: blue; -fx-cursor: hand;" text="Already have an account? Login here" />
</VBox>
