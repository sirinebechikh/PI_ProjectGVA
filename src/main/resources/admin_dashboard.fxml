<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="437.0" prefWidth="785.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.AdminController">
    <Label layoutX="300" layoutY="20" style="-fx-font-size: 24px;" text="List Of Users" />

    <Label layoutX="30.0" layoutY="110.0" text="Nom:" />
    <TextField fx:id="nameField" layoutX="100.0" layoutY="110.0" />

    <Label layoutX="30.0" layoutY="150.0" text="Email:" />
    <TextField fx:id="emailField" layoutX="100.0" layoutY="150.0" />

    <Label layoutX="30.0" layoutY="190.0" text="Mot de passe:" />
    <TextField fx:id="passwordField" layoutX="100.0" layoutY="190.0" />

    <Label layoutX="30.0" layoutY="230.0" text="Téléphone:" />
    <TextField fx:id="phoneField" layoutX="100.0" layoutY="230.0" />

    <Button fx:id="updateUserButton" layoutX="30.0" layoutY="290.0" onAction="#handleUpdateUser" text="Update" />
    <Button fx:id="deleteUserButton" layoutX="150.0" layoutY="290.0" onAction="#handleDeleteUser" text="Delete" />

    <TableView fx:id="userTable" layoutX="323.0" layoutY="81.0" prefHeight="328.0" prefWidth="427.0">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNom" text="Nom" />
            <TableColumn fx:id="colEmail" text="Email" />
            <TableColumn fx:id="colPassword" text="Mot de passe" />
            <TableColumn fx:id="colTelephone" text="Téléphone" />
        </columns>
    </TableView>
</AnchorPane>
