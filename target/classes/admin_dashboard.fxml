<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.AdminController">
    <Label text="List Of Users" layoutX="300" layoutY="20" style="-fx-font-size: 24px;"/>

    <Label text="Nom:" layoutX="30" layoutY="60"/>
    <TextField fx:id="nameField" layoutX="100" layoutY="60"/>

    <Label text="Email:" layoutX="30" layoutY="100"/>
    <TextField fx:id="emailField" layoutX="100" layoutY="100"/>

    <Label text="Mot de passe:" layoutX="30" layoutY="140"/>
    <TextField fx:id="passwordField" layoutX="100" layoutY="140"/>

    <Label text="Téléphone:" layoutX="30" layoutY="180"/>
    <TextField fx:id="phoneField" layoutX="100" layoutY="180"/>

    <Button fx:id="updateUserButton" text="Update" layoutX="30" layoutY="240" onAction="#handleUpdateUser"/>
    <Button fx:id="deleteUserButton" text="Delete" layoutX="150" layoutY="240" onAction="#handleDeleteUser"/>

    <TableView fx:id="userTable" layoutX="300" layoutY="60" prefWidth="400" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId" text="ID"/>
            <TableColumn fx:id="colNom" text="Nom"/>
            <TableColumn fx:id="colEmail" text="Email"/>
            <TableColumn fx:id="colPassword" text="Mot de passe"/>
            <TableColumn fx:id="colTelephone" text="Téléphone"/>
        </columns>
    </TableView>
</AnchorPane>
